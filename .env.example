# PostgreSQL connection string used by the API and Drizzle CLI.
DATABASE_URL=postgres://distil:distil@localhost:5432/distil

# API server port. In production Fastify also serves the built web assets from here.
PORT=4000

# node environment: development | production | test
NODE_ENV=development

# Max accepted upload size per file, in bytes (default 5 MB).
MAX_UPLOAD_BYTES=5242880

# Base multiplier for simulated processing phase delays (ms). Lower = faster demos.
PROCESSING_DELAY_MS=700

# Set to "false" to skip seeding demo fixtures on `pnpm db:seed`.
SEED_DEMO_DATA=true

# Set to "true" to re-run full demo seed when the library already has all fixtures.
SEED_FORCE=false

# Set to "true" to wipe documents before seeding (one-shot rebuild; unset after deploy).
SEED_RESET=false

# Comma-separated allowed CORS origins for local split dev. Ignored when same-origin.
CORS_ORIGIN=http://localhost:5173

# Optional OpenAI configuration for the gated LLM extractor.
# Leave OPENAI_API_KEY empty/unset to disable LLM calls entirely.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Per-document LLM input caps for cost and latency control.
LLM_MAX_PAGES=50
LLM_MAX_INPUT_CHARS=200000
LLM_MAX_INPUT_TOKENS=50000
LLM_CHUNK_CHARS=24000
LLM_MAX_CHUNKS=8
